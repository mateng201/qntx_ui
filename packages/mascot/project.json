{
  "name": "mascot",
  "projectType": "library",
  "sourceRoot": "packages/mascot/src",
  "tags": ["platform:shared", "type:lib"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit --project packages/mascot/tsconfig.json" }
    },
    "lint": { "executor": "nx:run-commands", "options": { "command": "oxlint packages/mascot" } },
    "boundaries": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/mascot --max-warnings 0" }
    }
  }
}
