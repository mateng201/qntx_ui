{
  "name": "content",
  "projectType": "library",
  "sourceRoot": "packages/content/src",
  "tags": ["platform:shared", "type:lib"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit --project packages/content/tsconfig.json" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "oxlint packages/content" }
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/content --max-warnings 0" }
    }
  }
}
