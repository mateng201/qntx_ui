{
  "name": "design-tokens",
  "projectType": "library",
  "sourceRoot": "packages/design-tokens/src",
  "tags": ["platform:shared", "type:lib"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit --project packages/design-tokens/tsconfig.json" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "oxlint packages/design-tokens" }
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/design-tokens --max-warnings 0" }
    }
  }
}
