{
  "name": "qntx-ui",
  "version": "0.1.0",
  "private": true,
  "description": "QuantX web and native mobile applications, managed with Nx and npm workspaces.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nx run web:dev --output-style=stream",
    "dev:web": "nx run web:dev --output-style=stream",
    "dev:mobile": "nx run mobile:start --output-style=stream",
    "dev:mobile:web": "nx run mobile:preview --output-style=stream",
    "build": "nx run web:build --output-style=stream",
    "build:mobile": "nx run mobile:export --output-style=stream",
    "preview": "nx run web:preview --output-style=stream",
    "check": "nx run-many -t check --parallel=1 --output-style=stream",
    "lint": "oxlint",
    "lint:boundaries": "nx run-many -t boundaries --parallel=1 --output-style=stream",
    "test:boundaries": "node tools/test-boundaries.mjs",
    "format": "oxfmt --write . && prettier --write \"apps/web/src/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"apps/web/src/**/*.astro\"",
    "test:e2e": "nx run web:test-e2e --output-style=stream",
    "test:mobile": "nx run mobile:test-preview --output-style=stream",
    "doctor:mobile": "nx run mobile:doctor --output-style=stream",
    "graph": "nx graph",
    "verify": "npm run check && npm run lint && npm run lint:boundaries && npm run test:boundaries && npm run format:check && npm run build && npm run build:mobile && npm run test:e2e && npm run test:mobile"
  },
  "devDependencies": {
    "@nx/devkit": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@playwright/test": "1.64.1",
    "@qntx/oxfmt": "1.1.1",
    "@qntx/oxlint": "1.1.1",
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "expo-doctor": "1.21.5",
    "node": "24.22.0",
    "nx": "24.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "packageManager": "npm@10.9.2"
}
