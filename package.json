{
  "name": "qntx-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, horizontally navigated QuantX website built with Astro, React, and Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt --write . && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.astro\"",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "latest",
    "@qntx/oxfmt": "^1.1.1",
    "@qntx/oxlint": "^1.1.1",
    "@qntx/tsconfig": "^1.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "node": "^24.22.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "typescript": "^6.0.0"
  },
  "packageManager": "npm@10.9.2"
}
