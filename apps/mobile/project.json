{
  "name": "mobile",
  "projectType": "application",
  "sourceRoot": "apps/mobile/src",
  "tags": ["platform:mobile", "type:app"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npm run start --workspace=mobile" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npm run preview --workspace=mobile" }
    },
    "export": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "npm run export --workspace=mobile" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run check --workspace=mobile" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "oxlint apps/mobile" }
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/mobile --max-warnings 0" }
    },
    "doctor": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run doctor --workspace=mobile" }
    },
    "test-preview": {
      "executor": "nx:run-commands",
      "options": { "command": "playwright test --config apps/mobile/playwright.config.ts" }
    }
  }
}
