---
import { palette } from "@qntx-ui/design-tokens";
import { HomePage } from "../components/HomePage";
import "../styles/global.css";
import "../styles/home-page.css";
---

<!doctype html>
<html lang="en" style={`--hover:${palette.hover}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="QuantX builds open protocols and infrastructure for autonomous AI agents to transact, collaborate, govern, and evolve on-chain."
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>QuantX — An open economy for autonomous agents</title>
  </head>
  <body>
    <HomePage />
    <script>
      import { initializeHomePageScroll } from "../scripts/home-page-scroll";

      const root = document.querySelector<HTMLElement>("[data-home-page]");
      if (root !== null) {
        const dispose = initializeHomePageScroll(root);
        document.addEventListener("astro:before-swap", dispose, { once: true });
      }
    </script>
  </body>
</html>
