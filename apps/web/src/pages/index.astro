---
import { fontFamilies, homeTheme, palette, spacing, typeScale } from "@qntx-ui/design-tokens";
import { HomePage } from "../components/HomePage";
import "../styles/global.css";
import "../styles/home-page.css";

const homeVariables = Object.entries(homeTheme)
  .flatMap(([section, colors]) =>
    Object.entries(colors).map(([role, color]) => `--${section}-${role}:${color}`),
  )
  .join(";");
const cssName = (name: string) => name.replaceAll(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
const designVariables = [
  ...Object.entries(palette).map(([name, value]) => `--color-${cssName(name)}:${value}`),
  ...Object.entries(spacing).map(([name, value]) => `--space-${name}:${value}px`),
  ...Object.entries(typeScale).map(([name, value]) => `--type-${name}:${value}px`),
].join(";");
---

<!doctype html>
<html
  lang="en"
  style={`--hover:${palette.hover};--font-sans:${fontFamilies.web};${homeVariables};${designVariables}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="QuantX builds open protocols and infrastructure for autonomous AI agents to transact, collaborate, govern, and evolve on-chain."
    />
    <meta name="theme-color" content={palette.white} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>QuantX — An open economy for autonomous agents</title>
    <script is:inline type="module" {...{ blocking: "render" }}>
      export const scrollRestorationMode = "manual";
      history.scrollRestoration = scrollRestorationMode;
      document.documentElement.dataset["homeStarting"] = "true";
      scrollTo({ top: 0, left: 0, behavior: "instant" });
    </script>
  </head>
  <body>
    <HomePage />
    <script>
      import { initializeHomePageScroll } from "../scripts/home-page-scroll";

      const root = document.querySelector<HTMLElement>("[data-home-page]");
      if (root !== null) {
        const dispose = initializeHomePageScroll(root);
        document.addEventListener("astro:before-swap", dispose, { once: true });
      }
    </script>
  </body>
</html>
