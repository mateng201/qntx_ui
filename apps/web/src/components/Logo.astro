---
import type { HTMLAttributes } from "astro/types";
import { logoPath } from "../data/logo";

type Props = {
  href?: HTMLAttributes<"a">["href"];
  label?: string;
  size?: number;
  class?: string;
};

const { href, label = "QNTX animated logo", size = 80, class: className = "" } = Astro.props;
const Tag = href === undefined ? "span" : "a";
---

<Tag
  href={href}
  class:list={["q-logo", className]}
  style={`--logo-size: ${size}px`}
  role={href === undefined ? "img" : undefined}
  tabindex={href === undefined ? 0 : undefined}
  aria-label={label}
  data-logo-trigger
  data-phase="rest"
>
  <svg
    viewBox="-150 -150 300 300"
    xmlns="http://www.w3.org/2000/svg"
    shape-rendering="geometricPrecision"
    aria-hidden="true"
    data-q-logo
  >
    <g data-q-root>
      <path data-q-id="body" fill="currentColor" fill-rule="evenodd" d={logoPath} />
      <g data-q-gaze>
        <path data-q-eye="left" fill="#ffffff" d="M0 0Z" display="none" />
        <path data-q-eye="right" fill="#ffffff" d="M0 0Z" display="none" />
      </g>
    </g>
  </svg>
</Tag>

<script>
  import { initializeLogoAnimations } from "../scripts/logo-animation";

  const dispose = initializeLogoAnimations();
  document.addEventListener("astro:before-swap", dispose, { once: true });
</script>

<style>
  .q-logo {
    display: inline-grid;
    place-items: center;
    width: var(--logo-size);
    height: var(--logo-size);
    flex-shrink: 0;
    color: inherit;
    outline-offset: 8px;
    vertical-align: middle;
  }
  .q-logo:focus-visible {
    outline: 1px solid #68735b;
    border-radius: 12px;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
</style>
