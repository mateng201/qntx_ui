{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["platform:web", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npm run dev --workspace=web" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "npm run build --workspace=web" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npm run preview --workspace=web" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run check --workspace=web" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "oxlint apps/web" }
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/web --max-warnings 0" }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "playwright test --config apps/web/playwright.config.ts" }
    }
  }
}
